__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
# 算例输出：体积大且可重算，不入库（result.json 除外，见下）
data/**/fields.bp/
data/**/*.bp/
data/_tmp_gmsh/
*.msh
*.xdmf
*.h5

# 参考文献 PDF 与从中提取的图：版权材料，不入库
*.pdf
data/_*.png
data/_*.jpeg
data/_*.json

# benchmark_ct_fatigue 是 D-22/D-23 那次被取代的运行（存档见 data/_ct_h2_norelax/），
# 其输出目录不入库以免与系列算例混淆。
data/benchmark_ct_fatigue/

# 一次性诊断脚本与日志（data/_*.sh、data/_*.log）：查问题时的脚手架，不入库。
# 值得留的结论写进 DECISIONS.md，值得留的检查写成 tests/ 里的回归。
data/_*.sh
data/_*.log
configs/_*.yaml
data/_ckpt_e2e*/
data/_ckpt_probe.bp/

# 断点：正在跑的算例每十几分钟改一次，且 .bp 是二进制目录，不入库
data/**/checkpoint.json
data/**/ckpt_*.bp/
data/_wall*/
data/_probe_snap/

# 外部源码依赖（asimov-contact），由 scripts/setup_env.sh 按固定 commit 拉取
.ext/

# 一次性诊断脚本（data/_*.py）与输出（data/_*.out）：同上，结论进 DECISIONS.md、检查进 tests/。
data/_*.py
data/_*.out
data/_study_done.txt
# 从 Lévesque 2011 全文提取的文本（data/_triboint2011.txt）：参考文献版权材料，同 *.pdf 不入库。
# 材料卡 sources.* 中的引用行号仍可据此对照原文。
data/_triboint2011.txt

# 测试产生的 ADIOS 缓存（test_phasefield 的 linear/newton 对比写入），不入库。
results/
